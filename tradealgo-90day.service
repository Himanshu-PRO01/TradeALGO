[Unit]
Description=TradeALGO 24/7 Autonomous Paper Trading & 90-Day SEBI Audit Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/TradeALGO
ExecStart=/usr/bin/python3 run_90day_logger.py --daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
StandardOutput=append:/var/log/tradealgo-daemon.log
StandardError=append:/var/log/tradealgo-daemon.log

[Install]
WantedBy=multi-user.target
