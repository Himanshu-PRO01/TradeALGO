# Copy this file to a new file named .env (in this same folder) and fill it in.
# The .env file is private: never share it, never commit it to Git, never paste it into a chat.

# Where your own OpenAlgo is running (the default is a copy on this same computer)
OPENALGO_HOST=http://127.0.0.1:5000

# Your OpenAlgo API key (from OpenAlgo's web page, under API Key)
OPENALGO_API_KEY=paste-your-key-here

# ── Practice Room: Live mode (optional) ──────────────────────────────────────
# Upstox Sandbox access token — get it from https://sandbox.upstox.com
# This is ONLY ever used with the sandbox API (fake money, no real orders ever).
# Leave blank to use Practice Room in local-only mode (no Upstox API calls).
UPSTOX_SANDBOX_ACCESS_TOKEN=paste-your-sandbox-token-here
