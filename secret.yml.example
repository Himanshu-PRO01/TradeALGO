# ==============================================================================
# TradeALGO AI API Keys Template
# ==============================================================================
# LOCAL USE:
# 1. Copy or rename this file to "secret.yml" in this same project folder.
# 2. secret.yml is included in .gitignore, so it will never be committed to Git.
#
# STREAMLIT COMMUNITY CLOUD USE:
# If you are hosting this app on Streamlit Cloud:
# 1. In your Streamlit Cloud app dashboard, click "..." (or Manage app) -> Settings.
# 2. Go to the "Secrets" tab.
# 3. Paste the following TOML block:
#
#    GEMINI_API_KEY = "AIzaSy..."
#    GROQ_API_KEY = "gsk_..."
#
# (Note: In Streamlit Cloud Secrets, use '=' with quotes, e.g. KEY = "val")
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY: "AIzaSy..."

# Groq API Key (Optional fallback, get from https://console.groq.com)
GROQ_API_KEY: "gsk_..."

# xAI Grok API Key (Optional, get from https://console.x.ai)
XAI_API_KEY: "xai-..."

# OpenAI API Key (Optional, get from https://platform.openai.com)
OPENAI_API_KEY: "sk-..."
